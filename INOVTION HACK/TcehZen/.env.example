# Database Connection String (Supabase Tokyo ap-northeast-1 Pooler on Port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# Supabase Credentials
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_<key>
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>

# Admin Configuration
ADMIN_EMAILS=tanishaqvermatechzen@gmail.com,ishaan.m1608@gmail.com,techzen.innovation@gmail.com
JWT_SECRET=your-secret-key-here
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Browser origin allowed through CORS, in addition to the built-in localhost
# entries and *.vercel.app. Set this to the production domain once one is
# attached, e.g. https://techzen.example.com
CLIENT_ORIGIN=

# On Vercel these belong in Project Settings -> Environment Variables, never in
# a committed .env. VITE_* values are inlined into the public client bundle at
# build time, so only ever put publishable keys behind that prefix.
